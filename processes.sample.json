{
  "version": 1,
  "settings": {
    "logLines": 200,
    "startWithWindows": false
  },
  "entries": [
    {
      "id": "blog-dev",
      "name": "Blog Dev",
      "cwd": "D:\\projects\\blog",
      "command": "npm run dev",
      "shell": "cmd",
      "encoding": "utf-8",
      "env": {
        "PORT": "3000"
      },
      "autoStart": false
    },
    {
      "id": "api",
      "name": "API Server",
      "cwd": "D:\\projects\\api",
      "command": "dotnet run",
      "shell": "cmd",
      "encoding": "utf-8",
      "autoStart": false,
      "extract": {
        "url": "Now listening on: (https?://\\S+)"
      },
      "actions": [
        { "label": "打开站点", "type": "open", "target": "${url}" },
        { "label": "复制地址", "type": "copy", "text": "${url}" }
      ]
    }
  ]
}
